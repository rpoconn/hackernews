{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["react", "typescript", "oxc", "vitest"],
    "ignorePatterns": [
        "src/routeTree.gen.ts",
        "src/api/hn/generated",
        "tools/openapi-codegen/node_modules",
        "dist",
        "playwright-report",
        "test-results"
    ],
    "rules": {
        "react/rules-of-hooks": "error",
        "react/only-export-components": [
            "warn",
            {
                "allowConstantExport": true
            }
        ],
        "no-console": "error"
    },
    "overrides": [
        {
            "files": ["src/lib/logger.ts", "**/*.test.ts", "**/*.test.tsx", "e2e/**"],
            "rules": {
                "no-console": "off"
            }
        },
        {
            "files": ["src/routes/**"],
            "rules": {
                "react/only-export-components": "off"
            }
        }
    ]
}
